{
    "name": "beegoodit/filament-split-button",
    "description": "Filament split button: primary action fused with a chevron dropdown of more actions",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "filament",
        "actions",
        "split-button",
        "beegoodit"
    ],
    "authors": [
        {
            "name": "BeegoodIT",
            "email": "dev@beegoodit.de"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/actions": "^4.0 || ^5.0",
        "filament/support": "^4.0 || ^5.0",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "BeegoodIT\\FilamentSplitButton\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "BeegoodIT\\FilamentSplitButton\\FilamentSplitButtonServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
