{
    "name": "beegoodit/filament-tenancy-plugins",
    "description": "Code catalog and morph assignments for Filament tenant plugin entitlements.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "BeegoodIT",
            "email": "dev@beegoodit.de"
        }
    ],
    "require": {
        "php": "^8.4",
        "filament/filament": "^4.0 || ^5.0",
        "illuminate/console": "^11.0|^12.0|^13.0",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0",
        "pestphp/pest": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "BeegoodIT\\FilamentTenancyPlugins\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BeegoodIT\\FilamentTenancyPlugins\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "BeegoodIT\\FilamentTenancyPlugins\\FilamentTenancyPluginsServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "pest --configuration phpunit.xml",
        "format": "pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
