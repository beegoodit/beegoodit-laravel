{
    "name": "beegoodit/datetime-picker",
    "description": "Livewire date/time range picker with year, quarter, month, and day selection. Optional Filament integration.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "livewire",
        "filament",
        "datetime",
        "datepicker",
        "range",
        "beegoodit"
    ],
    "authors": [
        {
            "name": "BeegoodIT",
            "email": "dev@beegoodit.de"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "livewire/livewire": "^3.0|^4.0",
        "nesbot/carbon": "^3.0"
    },
    "suggest": {
        "filament/filament": "Enables Filament schema View integration and Filament-styled UI (^4.0 || ^5.0)"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "BeegoodIT\\DateTimePicker\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BeegoodIT\\DateTimePicker\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "BeegoodIT\\DateTimePicker\\DateTimePickerServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
