{
    "name": "beegoodit/filament-entry-links",
    "description": "Marketing entry links with Filament admin and configurable redirects",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "filament",
        "redirect",
        "qr",
        "beegoodit"
    ],
    "authors": [
        {
            "name": "BeegoodIT",
            "email": "dev@beegoodit.de"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/database": "^11.0|^12.0",
        "illuminate/http": "^11.0|^12.0",
        "illuminate/routing": "^11.0|^12.0",
        "illuminate/events": "^11.0|^12.0",
        "illuminate/view": "^11.0|^12.0",
        "endroid/qr-code": "^6.0",
        "filament/filament": "^4.0 || ^5.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0",
        "rector/rector": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "BeegoodIT\\FilamentEntryLinks\\": "src/",
            "BeegoodIT\\FilamentEntryLinks\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BeegoodIT\\FilamentEntryLinks\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "BeegoodIT\\FilamentEntryLinks\\FilamentEntryLinksServiceProvider"
            ]
        }
    },
    "scripts": {
        "format": "pint",
        "rector": "rector process --dry-run",
        "rector:fix": "rector process"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
