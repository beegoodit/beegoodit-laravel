{
    "name": "beegoodit/eloquent-readonly-attributes",
    "description": "Conditionally guard Eloquent attributes from being changed",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "eloquent",
        "readonly",
        "attributes",
        "beegoodit"
    ],
    "authors": [
        {
            "name": "BeegoodIT",
            "email": "dev@beegoodit.de"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/database": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "BeegoodIT\\EloquentReadonlyAttributes\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BeegoodIT\\EloquentReadonlyAttributes\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "format": "pint",
        "phpmd": "php -d error_reporting=8191 ../../vendor/bin/phpmd src text codesize --minimum-priority 3"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
